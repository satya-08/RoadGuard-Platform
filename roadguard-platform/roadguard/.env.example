# RoadGuard Environment Configuration
# Application
PROJECT_NAME="RoadGuard"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY="roadguard-super-secret-production-key-change-in-production-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (MySQL 8 with automatic SQLite fallback)
DB_DRIVER=sqlite
# For MySQL:
# DB_DRIVER=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_mysql_password
# DB_NAME=roadguard_db
DATABASE_URL=sqlite:///./roadguard.db

# MongoDB Atlas Free Tier (M0) / Local MongoDB
# Optional dual-database sync: stores audit logs, GeoJSON documents, and raw telemetry
# Example MongoDB Atlas URI: mongodb+srv://<user>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
# Example Local MongoDB URI: mongodb://localhost:27017/roadguard_logs
MONGODB_URI=
MONGODB_DB_NAME=roadguard_logs
MONGODB_ENABLED=true

# Storage & Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# Model Inference Configuration
MODEL_PATH=../ml/checkpoints/roadsense_best.pt
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
IMAGE_SIZE=640
USE_GPU=False

# GIS Network Settings
TOLERANCE_METERS=250.0
DEFAULT_CENTER_LAT=16.8300
DEFAULT_CENTER_LON=81.5250

# Priority Scoring Weights (AHP derived)
W_SEVERITY=0.35
W_DENSITY=0.25
W_ROAD_HIERARCHY=0.20
W_LOCATION_RISK=0.10
W_COMPLAINTS=0.10
